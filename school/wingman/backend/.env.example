# Copy this file to .env and fill in your own values.
# Nothing in this file is committed with real secrets - .env is gitignored.

PORT=4000

# Get a key at https://console.anthropic.com/settings/keys
# Used to intelligently extract dates/weights/assignments from uploaded syllabi.
ANTHROPIC_API_KEY=

# Microsoft Graph / Outlook integration (optional - dashboard works fine without it).
# Register a free app at https://portal.azure.com -> App registrations -> New registration.
#   - Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
#   - Redirect URI (Web): http://localhost:4000/api/outlook/callback
#   - Under "Certificates & secrets", create a new client secret and paste it below.
#   - Under "API permissions", add Microsoft Graph delegated permission: Mail.Read, User.Read, offline_access
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:4000/api/outlook/callback
