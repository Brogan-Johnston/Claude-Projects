# Copy this file to .env and fill in your own values.
# Nothing in this file is committed with real secrets - .env is gitignored.

PORT=4000

# Get a key at https://console.anthropic.com/settings/keys
# Used to intelligently extract dates/weights/assignments from uploaded syllabi.
ANTHROPIC_API_KEY=

# Outlook inbox: no env vars needed. Wingman opens a real browser window (Playwright) for
# you to log into a personal Outlook.com/Hotmail account from Settings - see the README's
# "Connecting Outlook" section.

# Canvas import: also configured from the app's Settings page (your school's Canvas URL, then
# "Log in to Canvas" - a real browser window opens for you to sign in). No access token needed,
# so this works even if your school disables self-service tokens. See the README's
# "Connecting Canvas" section.
